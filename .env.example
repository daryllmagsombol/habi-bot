# Local development only. Copy to .env and never commit .env.
# These values are read by Docker Compose. The API process reads HOST, PORT, and
# NODE_ENV from its own environment; defaults are 127.0.0.1, 3001, and development.
POSTGRES_DB=habi
POSTGRES_USER=habi
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5432

# The staging and production stacks (compose.staging.yaml,
# compose.production.yaml) do not read this file. They require
# POSTGRES_PASSWORD, an immutable HABI_IMAGE_TAG (production), and the Hermes
# provider pair, and they fail fast with a `:?` message when a value is missing.
# See docs/runbooks/deployment.md for the per-stack variable table and for the
# P1 flag defaults. Do not put deployment secrets in this file, and do not add
# a default password, provider key, or token here: this file is a template.
