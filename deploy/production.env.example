# Production values for compose.production.yaml (H-011). Placeholders only.
#
# This file is not loaded automatically. Pass it explicitly:
#   docker compose --env-file deploy/production.env -f compose.production.yaml config
# Copy it outside the repository and replace every value at deploy time; never
# commit a filled copy. See deploy/README.md for the owner decisions that are
# still open (domain, TLS, image distribution, email, SSO).
#
# The name is deploy/production.env.example rather than .env.production.example
# on purpose: the CI release secret scan rejects tracked files named .env or
# .env.*, except .env.example.
HABI_IMAGE_TAG=replace-with-ci-commit-sha
POSTGRES_DB=habi
POSTGRES_USER=habi
POSTGRES_PASSWORD=replace-with-a-generated-production-password
API_HOST_PORT=3001
WEB_HOST_PORT=3000
