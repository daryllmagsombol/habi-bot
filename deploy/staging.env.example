# Staging values for compose.staging.yaml (H-011). Placeholders only.
#
# This file is not loaded automatically. Either pass it explicitly:
#   docker compose --env-file deploy/staging.env.example -f compose.staging.yaml config
# or export the same names in the deploy shell. Copy it outside the repository
# and replace every value before real use; never commit a filled copy.
#
# The name is deploy/staging.env.example rather than .env.staging.example on
# purpose: the CI release secret scan rejects tracked files named .env or
# .env.*, except .env.example.
HABI_IMAGE_TAG=staging
POSTGRES_DB=habi
POSTGRES_USER=habi
POSTGRES_PASSWORD=replace-with-a-generated-staging-password
API_HOST_PORT=3001
WEB_HOST_PORT=3000
