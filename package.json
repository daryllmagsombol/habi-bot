{
  "name": "habi",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=12.5.1 <13"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:verification": "node --test scripts/verify-foundation.test.mjs",
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "coverage": "c8 --all --src apps/backend/src --src apps/web/app --src packages/config/src --src packages/contracts/src --reporter=lcov --reporter=text-summary pnpm -r run test"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "turbo": "2.11.9"
  }
}
