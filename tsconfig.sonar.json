{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "allowJs": true,
    "checkJs": false,
    "experimentalDecorators": true
  },
  "include": [
    "apps/backend/src/**/*.ts",
    "apps/web/app/**/*.ts",
    "apps/web/app/**/*.tsx",
    "packages/contracts/src/**/*.ts",
    "packages/config/eslint/**/*.js",
    "packages/config/eslint/**/*.mjs",
    "scripts/**/*.js",
    "scripts/**/*.mjs"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/coverage/**",
    "scripts/**/*.test.mjs"
  ]
}
